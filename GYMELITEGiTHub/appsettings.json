{
  "ConnectionStrings": {
    "GymEliteDb": "Server=(localdb)\\MSSQLLocalDB;Database=GymEliteDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "GYMELITE",
    "Audience": "GYMELITE-API",
    "ExpirationMinutes": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Registro": {
    "Carpeta": "",
    "DiasConservados": 14
  },
  "BaseDatos": {
    "AplicarMigracionesAlIniciar": false
  },
  "Diagnostico": {
    "HabilitarPruebaError": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
