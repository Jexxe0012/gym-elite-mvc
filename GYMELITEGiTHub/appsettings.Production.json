{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Registro": {
    "DiasConservados": 30
  },
  "BaseDatos": {
    "AplicarMigracionesAlIniciar": true
  },
  "Diagnostico": {
    "HabilitarPruebaError": false
  }
}
