@model GYMELITEGiTHub.Dtos.VentaDto
@{ ViewData["Title"] = "Comprobante de venta"; }
@if(TempData["Exito"] is string exito){<div class="alert alert-success">@exito</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<div class="card" id="comprobante"><div class="card-body"><div class="d-flex justify-content-between"><div><h1 class="h3">GYM ELITE</h1><p>Comprobante de venta</p></div><div class="text-end"><strong>@Model.Numero</strong><br/>@Model.Fecha.ToString("dd/MM/yyyy HH:mm")<br/><span class="badge @(Model.Estado == "Registrada" ? "bg-success" : "bg-danger")">@Model.Estado</span></div></div><hr/>
<table class="table"><thead><tr><th>Producto</th><th class="text-end">Cantidad</th><th class="text-end">Precio</th><th class="text-end">Subtotal</th></tr></thead><tbody>@foreach(var d in Model.Detalles){<tr><td>@d.CodigoProducto - @d.NombreProducto</td><td class="text-end">@d.Cantidad</td><td class="text-end">@d.PrecioAplicado.ToString("C")</td><td class="text-end">@d.Subtotal.ToString("C")</td></tr>}</tbody><tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end">@Model.Total.ToString("C")</th></tr></tfoot></table></div></div>
<div class="mt-3"><a asp-action="Index" class="btn btn-outline-secondary">Volver</a> <button onclick="window.print()" class="btn btn-outline-primary">Imprimir</button>@if(Model.Estado == "Registrada"){<form asp-action="Anular" method="post" class="d-inline" onsubmit="return confirm('¿Anular la venta y devolver las existencias?');"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-outline-danger">Anular venta</button></form>}</div>
