@model GYMELITEGiTHub.ViewModels.VentaNuevaViewModel
@{ ViewData["Title"] = "Nueva venta"; }
<h1 class="h3">Nueva venta</h1><p class="text-muted">Indique la cantidad de los productos que desea vender.</p>
<form asp-action="Nueva" method="post"><partial name="_ErroresGenerales"/><div class="table-responsive bg-white border rounded"><table class="table align-middle mb-0"><thead><tr><th>Código</th><th>Producto</th><th>Precio</th><th>Disponible</th><th style="width:160px">Cantidad</th></tr></thead><tbody>
@for(var i=0;i<Model.Lineas.Count;i++){<tr><td>@Model.Lineas[i].Codigo<input asp-for="Lineas[i].ProductoId" type="hidden"/></td><td>@Model.Lineas[i].Nombre</td><td>@Model.Lineas[i].Precio.ToString("C")</td><td>@Model.Lineas[i].Existencias</td><td><input asp-for="Lineas[i].Cantidad" class="form-control cantidad" min="0" max="@Model.Lineas[i].Existencias" data-precio="@Model.Lineas[i].Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></td></tr>}
</tbody></table></div><div class="d-flex justify-content-between align-items-center mt-3"><h2 class="h4">Total estimado: <span id="total">$0.00</span></h2><div><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a> <button class="btn btn-success">Confirmar venta</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script>function calcular(){let t=0;document.querySelectorAll('.cantidad').forEach(x=>t+=(parseInt(x.value)||0)*parseFloat(x.dataset.precio));document.getElementById('total').textContent=t.toLocaleString('es-SV',{style:'currency',currency:'USD'});}document.querySelectorAll('.cantidad').forEach(x=>x.addEventListener('input',calcular));calcular();</script> }
