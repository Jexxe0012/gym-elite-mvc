@model GYMELITEGiTHub.ViewModels.UsuarioListaViewModel
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Usuarios</h1>
        <small class="text-muted">Cuentas con acceso al sistema y su rol.</small>
    </div>
    <a asp-action="Crear" class="btn btn-success">+ Nuevo usuario</a>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success" role="status">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="table-responsive bg-white border rounded">
    <table class="table table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th scope="col">Correo</th>
                <th scope="col">Rol</th>
                <th scope="col">Estado</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Model.Usuarios)
        {
            <tr>
                <td>@u.Correo @if (u.EsUsuarioActual) { <span class="badge text-bg-secondary">Tú</span> }</td>
                <td>@u.Rol</td>
                <td>
                    @if (u.Habilitado) { <span class="badge text-bg-success">Habilitado</span> }
                    else { <span class="badge text-bg-danger">Deshabilitado</span> }
                </td>
                <td class="text-end text-nowrap">
                    <a asp-action="Editar" asp-route-id="@u.Id">Cambiar rol</a> ·
                    <a asp-action="RestablecerContrasena" asp-route-id="@u.Id">Restablecer contraseña</a>
                    @if (!u.EsUsuarioActual)
                    {
                        <span> · </span>
                        <form asp-action="CambiarEstado" asp-route-id="@u.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link p-0 align-baseline">
                                @(u.Habilitado ? "Deshabilitar" : "Habilitar")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
