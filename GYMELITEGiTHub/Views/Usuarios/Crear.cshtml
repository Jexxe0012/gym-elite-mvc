@model GYMELITEGiTHub.ViewModels.UsuarioCrearViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}

<h1 class="h3 mb-3">Nuevo usuario</h1>
<p class="text-muted">El usuario inicia sesión con su correo y la contraseña que se defina aquí.</p>

<partial name="_ErroresGenerales" />

<form asp-action="Crear" method="post" class="bg-white border rounded p-4" style="max-width: 640px;">
    <div class="mb-3">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" autocomplete="off" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmarPassword" class="form-label"></label>
        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Rol" class="form-label"></label>
        <select asp-for="Rol" asp-items="Model.Roles" class="form-select">
            <option value="">Seleccione un rol</option>
        </select>
        <span asp-validation-for="Rol" class="text-danger"></span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-success">Crear usuario</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
