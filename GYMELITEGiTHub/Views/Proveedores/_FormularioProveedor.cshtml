@model GYMELITEGiTHub.ViewModels.ProveedorCreateViewModel

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" placeholder="Ej. Distribuidora NutriMax" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Telefono" class="form-label"></label>
    <input asp-for="Telefono" class="form-control" placeholder="Ej. 2222-0000" />
    <span asp-validation-for="Telefono" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Correo" class="form-label"></label>
    <input asp-for="Correo" class="form-control" placeholder="ventas@proveedor.com" />
    <span asp-validation-for="Correo" class="text-danger"></span>
</div>
