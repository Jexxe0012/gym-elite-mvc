@{
    Layout = null;
    var codigo = ViewData["Codigo"] as int? ?? 0;
    var (titulo, mensaje) = codigo switch
    {
        404 => ("Página no encontrada", "La dirección no existe o el registro ya no está disponible."),
        403 => ("Acceso no permitido", "Su usuario no tiene permiso para esta sección."),
        405 => ("Operación no permitida", "La acción solicitada no está disponible de esta forma."),
        _ => ("No se pudo procesar la solicitud", "Revise los datos e intente nuevamente.")
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@titulo - GYM ELITE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <main class="container py-5" style="max-width: 640px;">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <p class="text-muted mb-1">Código @codigo</p>
                <h1 class="h3">@titulo</h1>
                <p class="mt-3">@mensaje</p>
                <a class="btn btn-success mt-2" href="~/">Volver al inicio</a>
            </div>
        </div>
    </main>
</body>
</html>
