@using System.Globalization
@model GYMELITEGiTHub.ViewModels.PagoListaViewModel
@{
    ViewData["Title"] = "Pagos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Pagos y recibos</h1>
        <small class="text-muted">Consulta los cobros de membresías y sus comprobantes.</small>
    </div>
    <a asp-action="Registrar" class="btn btn-success">+ Registrar pago</a>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success" role="status">@exito</div>
}
@if (TempData["Aviso"] is string aviso)
{
    <div class="alert alert-warning" role="status">@aviso</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<partial name="_ErroresGenerales" />

<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="bg-white border rounded p-3 h-100">
            <div class="text-muted">Pagos válidos de hoy</div>
            <div class="h3 mb-0">@Model.PagosHoy</div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="bg-white border rounded p-3 h-100">
            <div class="text-muted">Total cobrado hoy</div>
            <div class="h3 mb-0">$@Model.MontoHoy.ToString("N2", CultureInfo.InvariantCulture)</div>
        </div>
    </div>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3 align-items-start">
    <div class="col-lg-4">
        <label asp-for="Busqueda" class="form-label">Buscar</label>
        <input asp-for="Busqueda" class="form-control" type="search" placeholder="Socio, código o número de recibo..." />
        <span asp-validation-for="Busqueda" class="text-danger"></span>
    </div>
    <div class="col-lg-2 col-sm-6">
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado" class="form-select">
            <option value="">Todos</option>
            <option value="Registrado">Registrados</option>
            <option value="Anulado">Anulados</option>
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>
    <div class="col-lg-2 col-sm-6">
        <label asp-for="FechaDesde" class="form-label"></label>
        <input asp-for="FechaDesde" type="date" class="form-control" />
        <span asp-validation-for="FechaDesde" class="text-danger"></span>
    </div>
    <div class="col-lg-2 col-sm-6">
        <label asp-for="FechaHasta" class="form-label"></label>
        <input asp-for="FechaHasta" type="date" class="form-control" />
        <span asp-validation-for="FechaHasta" class="text-danger"></span>
    </div>
    <div class="col-lg-2 col-sm-6 d-flex flex-wrap gap-2 align-self-end pb-1">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

@if (!Model.Pagos.Any())
{
    <div class="alert alert-light border">No se encontraron pagos con los filtros seleccionados.</div>
}
else
{
    <div class="table-responsive bg-white border rounded">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th scope="col">Recibo</th>
                    <th scope="col">Fecha de cobro</th>
                    <th scope="col">Socio</th>
                    <th scope="col">Plan</th>
                    <th scope="col" class="text-end">Monto</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pago in Model.Pagos)
                {
                    <tr>
                        <td>@pago.NumeroRecibo</td>
                        <td>@pago.FechaHoraCobro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@pago.SocioCodigo · @pago.SocioNombre</td>
                        <td>@pago.PlanNombre</td>
                        <td class="text-end text-nowrap">@pago.MontoTexto</td>
                        <td><span class="badge @(pago.EstaAnulado ? "bg-secondary" : "bg-success") text-white">@pago.Estado</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Recibo" asp-route-id="@pago.Id" aria-label="Ver recibo @pago.NumeroRecibo">Ver recibo</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
