@model GYMELITEGiTHub.ViewModels.CompraListaViewModel
@{
    ViewData["Title"] = "Compras";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Compras a proveedores</h1>
        <small class="text-muted">Cada compra registrada suma unidades al inventario.</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Proveedores" asp-action="Index" class="btn btn-outline-secondary">Proveedores</a>
        <a asp-action="Nueva" class="btn btn-success">+ Nueva compra</a>
    </div>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success" role="status">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<partial name="_ErroresGenerales" />

<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="bg-white border rounded p-3 h-100">
            <div class="text-muted">Compras registradas este mes</div>
            <div class="h3 mb-0">@Model.ResumenMes.Cantidad</div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="bg-white border rounded p-3 h-100">
            <div class="text-muted">Total comprado este mes</div>
            <div class="h3 mb-0">@Model.ResumenMes.TotalTexto</div>
        </div>
    </div>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3 align-items-start">
    <div class="col-lg-3 col-sm-6">
        <label asp-for="ProveedorId" class="form-label"></label>
        <select asp-for="ProveedorId" asp-items="Model.Proveedores" class="form-select">
            <option value="">Todos</option>
        </select>
    </div>
    <div class="col-lg-2 col-sm-6">
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado" class="form-select">
            <option value="">Todos</option>
            <option value="Registrada">Registradas</option>
            <option value="Anulada">Anuladas</option>
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>
    <div class="col-lg-2 col-sm-6">
        <label asp-for="FechaDesde" class="form-label"></label>
        <input asp-for="FechaDesde" type="date" class="form-control" />
    </div>
    <div class="col-lg-2 col-sm-6">
        <label asp-for="FechaHasta" class="form-label"></label>
        <input asp-for="FechaHasta" type="date" class="form-control" />
        <span asp-validation-for="FechaHasta" class="text-danger"></span>
    </div>
    <div class="col-lg-3 d-flex flex-wrap gap-2 align-self-end pb-1">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

@if (!Model.Compras.Any())
{
    <div class="alert alert-light border">No se encontraron compras con los filtros seleccionados.</div>
}
else
{
    <div class="table-responsive bg-white border rounded">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th scope="col">Número</th>
                    <th scope="col">Fecha</th>
                    <th scope="col">Proveedor</th>
                    <th scope="col" class="text-end">Líneas</th>
                    <th scope="col" class="text-end">Unidades</th>
                    <th scope="col" class="text-end">Total</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Compras)
            {
                <tr>
                    <td>@c.Numero</td>
                    <td>@c.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@c.ProveedorNombre</td>
                    <td class="text-end">@c.Lineas.Count</td>
                    <td class="text-end">@c.Unidades</td>
                    <td class="text-end text-nowrap">@c.TotalTexto</td>
                    <td><span class="badge @(c.EstaAnulada ? "bg-secondary" : "bg-success") text-white">@c.Estado</span></td>
                    <td class="text-end"><a asp-action="Detalle" asp-route-id="@c.Id">Ver</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
