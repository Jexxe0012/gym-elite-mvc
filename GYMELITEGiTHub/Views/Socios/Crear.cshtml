@model GYMELITEGiTHub.ViewModels.SocioCreateViewModel
@{
    ViewData["Title"] = "Nuevo socio";
}

<h1 class="h3 mb-3">Nuevo socio</h1>
<p class="text-muted">El código y el QR del socio se generan automáticamente al guardar.</p>

<form asp-action="Crear" method="post" class="bg-white border rounded p-4" style="max-width: 640px;">
    <partial name="_FormularioSocio" model="Model" />
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-success">Guardar socio</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
