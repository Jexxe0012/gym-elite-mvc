@model GYMELITEGiTHub.ViewModels.AccesoHistorialViewModel
@{
    ViewData["Title"] = "Historial de accesos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Historial de accesos</h1>
        <small class="text-muted">Ingresos autorizados registrados en recepción.</small>
    </div>
    <a asp-action="Index" class="btn btn-success">Verificar acceso</a>
</div>

<partial name="_ErroresGenerales" />

<form asp-action="Historial" method="get" class="row g-2 mb-3 align-items-start">
    <div class="col-lg-5">
        <label asp-for="Busqueda" class="form-label"></label>
        <input asp-for="Busqueda" class="form-control" type="search" placeholder="Socio o código..." />
        <span asp-validation-for="Busqueda" class="text-danger"></span>
    </div>
    <div class="col-lg-2 col-sm-6">
        <label asp-for="FechaDesde" class="form-label"></label>
        <input asp-for="FechaDesde" type="date" class="form-control" />
        <span asp-validation-for="FechaDesde" class="text-danger"></span>
    </div>
    <div class="col-lg-2 col-sm-6">
        <label asp-for="FechaHasta" class="form-label"></label>
        <input asp-for="FechaHasta" type="date" class="form-control" />
        <span asp-validation-for="FechaHasta" class="text-danger"></span>
    </div>
    <div class="col-lg-3 d-flex flex-wrap gap-2 align-self-end pb-1">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a asp-action="Historial" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

@if (!Model.Accesos.Any())
{
    <div class="alert alert-light border">No se encontraron accesos con los filtros seleccionados.</div>
}
else
{
    <p class="text-muted mb-2">
        @Model.Accesos.Count registro(s)
        @if (Model.Accesos.Count >= GYMELITEGiTHub.ViewModels.AccesoHistorialViewModel.LimiteRegistros)
        {
            <span>(se muestran los más recientes; use los filtros para acotar)</span>
        }
    </p>
    <div class="table-responsive bg-white border rounded">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th scope="col">Fecha y hora</th>
                    <th scope="col">Socio</th>
                    <th scope="col">Plan</th>
                    <th scope="col">Registrado por</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var acceso in Model.Accesos)
                {
                    <tr>
                        <td>@acceso.FechaHoraIngreso.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@acceso.SocioCodigo · @acceso.SocioNombre</td>
                        <td>@acceso.PlanNombre</td>
                        <td>@(acceso.UsuarioResponsableId ?? "—")</td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Membresias" asp-action="Detalle" asp-route-id="@acceso.MembresiaId">Ver membresía</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
