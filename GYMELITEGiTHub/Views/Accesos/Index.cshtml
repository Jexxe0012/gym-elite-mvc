@using GYMELITEGiTHub.Dtos
@model GYMELITEGiTHub.ViewModels.AccesoVerificarViewModel
@{
    ViewData["Title"] = "Accesos";
    var verificacion = Model.Verificacion;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Verificación de acceso</h1>
        <small class="text-muted">Escanee el QR del socio o búsquelo para validar su membresía y registrar el ingreso.</small>
    </div>
    <a asp-action="Historial" class="btn btn-outline-secondary">Historial de accesos</a>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success" role="status">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<partial name="_ErroresGenerales" />

<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="bg-white border rounded p-3 h-100">
            <div class="text-muted">Ingresos de hoy</div>
            <div class="h3 mb-0">@Model.IngresosHoy</div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="bg-white border rounded p-3 h-100">
            <div class="text-muted">Socios distintos hoy</div>
            <div class="h3 mb-0">@Model.SociosHoy</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="bg-white border rounded p-4 h-100">
            <h2 class="h5">Lector de código QR</h2>
            <form id="formBusqueda" asp-action="Index" method="get" autocomplete="off">
                <label asp-for="Busqueda" class="form-label"></label>
                <input asp-for="Busqueda" id="campoBusqueda" class="form-control form-control-lg" type="search"
                       placeholder="Escanee o escriba aquí..." autofocus />
                <span asp-validation-for="Busqueda" class="text-danger"></span>
                <div class="form-text">
                    Un lector de QR USB escribe el código en este campo y envía con Enter. También puede
                    escribir el código del socio (S-001), su nombre o su teléfono.
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button type="submit" class="btn btn-success">Verificar acceso</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                    <button type="button" id="btnCamara" class="btn btn-outline-secondary d-none">Usar cámara</button>
                </div>
            </form>

            <div id="contenedorCamara" class="mt-3 d-none">
                <video id="videoCamara" class="w-100 rounded border bg-dark" playsinline muted
                       aria-label="Vista de la cámara para leer el código QR"></video>
                <div class="form-text">Coloque el código QR dentro del marco. Se verificará al leerlo.</div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="bg-white border rounded p-4 h-100" aria-live="polite">
            <h2 class="h5">Resultado</h2>

            @if (verificacion is null)
            {
                <p class="text-muted mb-0">Escanee un código QR o busque un socio para ver su cobertura.</p>
            }
            else if (verificacion.Resultado == ResultadoBusquedaAcceso.NoEncontrado)
            {
                <div class="alert alert-warning mb-0">@verificacion.Motivo</div>
            }
            else if (verificacion.Resultado == ResultadoBusquedaAcceso.VariosResultados)
            {
                <p class="text-muted">@verificacion.Motivo</p>
                <div class="list-group">
                    @foreach (var candidato in verificacion.Candidatos)
                    {
                        <a asp-action="Index" asp-route-busqueda="@candidato.Codigo"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span>@candidato.Codigo · @candidato.NombreCompleto</span>
                            <small class="text-muted">@candidato.Telefono</small>
                        </a>
                    }
                </div>
                @if (verificacion.TotalCandidatos > verificacion.Candidatos.Count)
                {
                    <div class="form-text mt-2">
                        Se muestran @verificacion.Candidatos.Count de @verificacion.TotalCandidatos coincidencias. Refine la búsqueda.
                    </div>
                }
            }
            else
            {
                var socio = verificacion.Socio!;
                var membresia = verificacion.Membresia;

                <div class="mb-3">
                    @if (verificacion.Autorizado)
                    {
                        <span class="badge text-bg-success fs-6">ACCESO AUTORIZADO</span>
                    }
                    else
                    {
                        <span class="badge text-bg-danger fs-6">ACCESO DENEGADO</span>
                    }
                </div>

                <h3 class="h4 mb-0">@socio.NombreCompleto</h3>
                <div class="text-muted mb-3">@socio.Codigo · @socio.Telefono</div>

                @if (!verificacion.Autorizado)
                {
                    <div class="alert alert-danger" role="alert">@verificacion.Motivo</div>
                }

                @if (membresia is not null)
                {
                    <dl class="row mb-3">
                        <dt class="col-sm-4">Plan</dt>
                        <dd class="col-sm-8">@membresia.TipoNombre (@membresia.Modalidad)</dd>
                        <dt class="col-sm-4">Vigencia</dt>
                        <dd class="col-sm-8">
                            @membresia.FechaInicio.ToString("dd/MM/yyyy") al @membresia.FechaFin.ToString("dd/MM/yyyy")
                            <partial name="~/Views/Membresias/_BadgeVigencia.cshtml" model="membresia.Vigencia" />
                            @if (verificacion.Autorizado && membresia.DiasRestantes > 0)
                            {
                                <small class="text-muted ms-2">Faltan @membresia.DiasRestantes día(s)</small>
                            }
                        </dd>
                        <dt class="col-sm-4">Pago</dt>
                        <dd class="col-sm-8">
                            @if (membresia.TienePagoValido)
                            {
                                <span>Recibo @membresia.NumeroRecibo</span>
                            }
                            else
                            {
                                <span class="text-muted">Sin pago registrado</span>
                            }
                        </dd>
                        <dt class="col-sm-4">Último ingreso</dt>
                        <dd class="col-sm-8">
                            @(verificacion.UltimoIngreso?.ToString("dd/MM/yyyy HH:mm") ?? "Sin ingresos registrados")
                        </dd>
                    </dl>
                }

                <div class="d-flex flex-wrap gap-2">
                    @if (verificacion.Autorizado)
                    {
                        <form asp-action="Registrar" method="post">
                            <input type="hidden" name="socioId" value="@socio.Id" />
                            <button type="submit" class="btn btn-success btn-lg">Registrar ingreso</button>
                        </form>
                    }
                    else if (membresia is not null && membresia.Vigencia == EstadoVigencia.PendientePago)
                    {
                        <a asp-controller="Pagos" asp-action="Registrar" asp-route-membresiaId="@membresia.Id"
                           class="btn btn-warning">Cobrar membresía</a>
                    }
                    else if (membresia is null || membresia.Vigencia is EstadoVigencia.Vencida or EstadoVigencia.Cancelada)
                    {
                        @if (socio.EstaHabilitado)
                        {
                            <a asp-controller="Membresias" asp-action="Renovar" asp-route-socioId="@socio.Id"
                               class="btn btn-warning">Renovar membresía</a>
                        }
                    }
                    <a asp-controller="Socios" asp-action="Detalle" asp-route-id="@socio.Id"
                       class="btn btn-outline-secondary">Ver ficha del socio</a>
                </div>
            }
        </div>
    </div>
</div>

<div class="mt-4">
    <h2 class="h5">Últimos accesos</h2>
    @if (!Model.Recientes.Any())
    {
        <div class="alert alert-light border">Todavía no hay ingresos registrados.</div>
    }
    else
    {
        <div class="table-responsive bg-white border rounded">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th scope="col">Fecha y hora</th>
                        <th scope="col">Socio</th>
                        <th scope="col">Plan</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acceso in Model.Recientes)
                    {
                        <tr>
                            <td>@acceso.FechaHoraIngreso.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@acceso.SocioCodigo · @acceso.SocioNombre</td>
                            <td>@acceso.PlanNombre</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        // La cámara es opcional: el botón solo aparece si el navegador sabe leer códigos QR.
        // Con un lector USB o escribiendo el código, la pantalla funciona igual sin esto.
        (function () {
            var boton = document.getElementById('btnCamara');
            var contenedor = document.getElementById('contenedorCamara');
            var video = document.getElementById('videoCamara');
            var campo = document.getElementById('campoBusqueda') || document.getElementById('Busqueda');
            var formulario = document.getElementById('formBusqueda');

            if (!boton || !('BarcodeDetector' in window) ||
                !navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                return;
            }

            boton.classList.remove('d-none');

            var flujo = null;
            var activo = false;

            function detener() {
                activo = false;
                if (flujo) {
                    flujo.getTracks().forEach(function (pista) { pista.stop(); });
                    flujo = null;
                }
                contenedor.classList.add('d-none');
                boton.textContent = 'Usar cámara';
            }

            boton.addEventListener('click', async function () {
                if (activo) { detener(); return; }

                try {
                    var detector = new BarcodeDetector({ formats: ['qr_code'] });
                    flujo = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
                    video.srcObject = flujo;
                    await video.play();
                    contenedor.classList.remove('d-none');
                    boton.textContent = 'Detener cámara';
                    activo = true;

                    var leer = async function () {
                        if (!activo) { return; }
                        try {
                            var codigos = await detector.detect(video);
                            if (codigos.length > 0) {
                                campo.value = codigos[0].rawValue;
                                detener();
                                formulario.submit();
                                return;
                            }
                        } catch (errorLectura) { /* se reintenta en el siguiente ciclo */ }
                        setTimeout(leer, 300);
                    };
                    leer();
                } catch (error) {
                    detener();
                    alert('No se pudo usar la cámara. Escriba el código manualmente.');
                }
            });
        })();
    </script>
}
