@model ErrorViewModel
@{
    // Vista independiente del layout para que se muestre aunque el error venga del layout.
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error - GYM ELITE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <main class="container py-5" style="max-width: 640px;">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 text-danger">No pudimos completar la operación</h1>
                <p class="mt-3">
                    Ocurrió un problema inesperado. La información técnica quedó registrada
                    para que el administrador del sistema pueda revisarla.
                </p>
                @if (Model?.ShowRequestId == true)
                {
                    <p class="mb-1">Si el problema continúa, comparta este código de seguimiento:</p>
                    <p><code>@Model.RequestId</code></p>
                }
                <a class="btn btn-success mt-2" href="~/">Volver al inicio</a>
            </div>
        </div>
    </main>
</body>
</html>
