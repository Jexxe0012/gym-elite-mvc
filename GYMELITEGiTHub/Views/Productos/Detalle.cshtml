@model GYMELITEGiTHub.Dtos.ProductoDto
@{ ViewData["Title"] = "Detalle de producto"; }
@if(TempData["Exito"] is string exito){<div class="alert alert-success">@exito</div>}
<div class="d-flex justify-content-between"><div><h1 class="h3">@Model.Codigo - @Model.Nombre</h1><p class="text-muted">@Model.Categoria</p></div><div><a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar</a> <a asp-action="Ajustar" asp-route-id="@Model.Id" class="btn btn-success">Ajustar inventario</a></div></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card"><div class="card-body"><small>Precio</small><h2>@Model.PrecioVenta.ToString("C")</h2></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><small>Existencias</small><h2>@Model.Existencias</h2></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><small>Estado</small><h2>@Model.EstadoExistencias</h2></div></div></div></div>
<h2 class="h4">Historial de movimientos</h2><div class="table-responsive bg-white border rounded"><table class="table mb-0"><thead><tr><th>Fecha</th><th>Tipo</th><th>Cantidad</th><th>Motivo</th><th>Origen</th></tr></thead><tbody>@foreach(var m in Model.Movimientos){<tr><td>@m.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td><td>@m.Tipo</td><td>@m.Cantidad</td><td>@m.Motivo</td><td>@m.OperacionOrigen</td></tr>}</tbody></table></div>
@if(Model.Activo){<form asp-action="Desactivar" method="post" class="mt-3" onsubmit="return confirm('¿Desactivar este producto?');"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-outline-danger">Desactivar producto</button></form>}
