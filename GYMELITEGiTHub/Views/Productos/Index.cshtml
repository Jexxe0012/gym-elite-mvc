@model GYMELITEGiTHub.ViewModels.ProductoListaViewModel
@{ ViewData["Title"] = "Productos"; }

<div class="d-flex justify-content-between align-items-center mb-3">
 <div><h1 class="h3 mb-0">Productos e inventario</h1><small class="text-muted">Catálogo, existencias y movimientos.</small></div>
 <a asp-action="Crear" class="btn btn-success">+ Nuevo producto</a>
</div>
@if (TempData["Exito"] is string exito) { <div class="alert alert-success">@exito</div> }
<div class="row g-3 mb-4">
 <div class="col-md-4"><div class="card h-100"><div class="card-body"><small>Productos activos</small><h2>@Model.ProductosActivos</h2></div></div></div>
 <div class="col-md-4"><div class="card h-100"><div class="card-body"><small>Stock bajo o agotado</small><h2>@Model.ProductosStockBajo</h2></div></div></div>
 <div class="col-md-4"><div class="card h-100"><div class="card-body"><small>Unidades disponibles</small><h2>@Model.UnidadesDisponibles</h2></div></div></div>
</div>
<form method="get" class="row g-2 mb-3">
 <div class="col-md-6"><input name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar por nombre o código..." /></div>
 <div class="col-md-4"><select name="categoria" class="form-select"><option value="">Todas las categorías</option>@foreach (var c in GYMELITEGiTHub.ViewModels.ProductoCreateViewModel.Categorias) { if (Model.Categoria == c) { <option value="@c" selected>@c</option> } else { <option value="@c">@c</option> } }</select></div>
 <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Filtrar</button></div>
</form>
<div class="table-responsive bg-white border rounded">
 <table class="table table-hover align-middle mb-0"><thead><tr><th>Código</th><th>Producto</th><th>Categoría</th><th>Precio</th><th>Existencias</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
 @foreach (var p in Model.Productos) {
  var clase = p.EstadoExistencias == "Disponible" ? "bg-success" : p.EstadoExistencias == "Stock bajo" ? "bg-warning text-dark" : "bg-danger";
  <tr><td>@p.Codigo</td><td>@p.Nombre @if(!p.Activo){<span class="badge bg-secondary">Inactivo</span>}</td><td>@p.Categoria</td><td>@p.PrecioVenta.ToString("C")</td><td>@p.Existencias</td><td><span class="badge @clase">@p.EstadoExistencias</span></td><td class="text-end"><a asp-action="Detalle" asp-route-id="@p.Id">Ver</a> · <a asp-action="Editar" asp-route-id="@p.Id">Editar</a> · <a asp-action="Ajustar" asp-route-id="@p.Id">Ajustar</a></td></tr>
 }
 </tbody></table>
</div>
@if (!Model.Productos.Any()) { <div class="alert alert-light border mt-3">No se encontraron productos.</div> }
