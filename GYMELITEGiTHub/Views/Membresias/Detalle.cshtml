@using GYMELITEGiTHub.Dtos
@model GYMELITEGiTHub.Dtos.MembresiaDto
@{
    ViewData["Title"] = "Detalle de membresía";
}

<h1 class="h3 mb-3">Membresía <small class="text-muted">#@Model.Id</small></h1>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}
@if (TempData["Aviso"] is string aviso)
{
    <div class="alert alert-warning">@aviso</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="bg-white border rounded p-4" style="max-width: 640px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Socio</dt>
        <dd class="col-sm-8">
            <a asp-controller="Socios" asp-action="Detalle" asp-route-id="@Model.SocioId">
                @Model.SocioCodigo · @Model.SocioNombre
            </a>
        </dd>
        <dt class="col-sm-4">Plan</dt><dd class="col-sm-8">@Model.TipoNombre (@Model.Modalidad)</dd>
        <dt class="col-sm-4">Inicio</dt><dd class="col-sm-8">@Model.FechaInicio.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-4">Vence</dt><dd class="col-sm-8">@Model.FechaFin.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-4">Períodos</dt><dd class="col-sm-8">@Model.PeriodosAdquiridos</dd>
        <dt class="col-sm-4">Monto a cobrar</dt><dd class="col-sm-8">@Model.TotalTexto</dd>
        <dt class="col-sm-4">Pago</dt>
        <dd class="col-sm-8">
            @if (Model.TienePagoValido)
            {
                <span>Recibo @Model.NumeroRecibo · @Model.MontoPagadoTexto · @Model.FechaPago?.ToString("dd/MM/yyyy HH:mm")</span>
            }
            else
            {
                <span class="text-muted">Sin pago registrado</span>
            }
        </dd>
        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8">
            <partial name="_BadgeVigencia" model="Model.Vigencia" />
            @if (Model.EsEfectiva && Model.DiasRestantes > 0)
            {
                <small class="text-muted ms-2">Faltan @Model.DiasRestantes día(s)</small>
            }
        </dd>
    </dl>
</div>

<div class="d-flex flex-wrap gap-2 mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>

    @if (!Model.EstaCancelada)
    {
        <a asp-action="Renovar" asp-route-socioId="@Model.SocioId" class="btn btn-success">Renovar</a>

        @if (Model.Vigencia == EstadoVigencia.PendientePago)
        {
            @* El cobro posterior lo registra el módulo Pagos *@
            <a asp-controller="Pagos" asp-action="Registrar" asp-route-membresiaId="@Model.Id"
               class="btn btn-warning">Cobrar</a>
        }

        <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('¿Cancelar esta membresía? Si ya fue cobrada, el recibo se anulará.');">
            <button type="submit" class="btn btn-outline-danger">Cancelar membresía</button>
        </form>
    }
</div>
