@model GYMELITEGiTHub.ViewModels.MembresiaCreateViewModel
@{
    ViewData["Title"] = "Registrar membresía";
}

<h1 class="h3 mb-3">Registrar o renovar membresía</h1>
<p class="text-muted">
    La fecha de vencimiento se calcula con la duración del plan por los períodos adquiridos.
    El monto a cobrar es el precio del plan por los períodos.
</p>

<form asp-action="Crear" method="post" class="bg-white border rounded p-4" style="max-width: 640px;">
    <partial name="_ErroresGenerales" />

    <div class="mb-3">
        <label asp-for="SocioId" class="form-label"></label>
        <select asp-for="SocioId" asp-items="Model.Socios" class="form-select">
            <option value="">-- Seleccione un socio --</option>
        </select>
        <span asp-validation-for="SocioId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TipoMembresiaId" class="form-label"></label>
        <select asp-for="TipoMembresiaId" asp-items="Model.Tipos" class="form-select">
            <option value="">-- Seleccione un plan --</option>
        </select>
        <span asp-validation-for="TipoMembresiaId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FechaInicio" class="form-label"></label>
        <input asp-for="FechaInicio" type="date" class="form-control" />
        <span asp-validation-for="FechaInicio" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PeriodosAdquiridos" class="form-label"></label>
        <input asp-for="PeriodosAdquiridos" type="number" min="1" max="36" class="form-control" />
        <span asp-validation-for="PeriodosAdquiridos" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="CobrarAhora" class="form-check-input" />
        <label asp-for="CobrarAhora" class="form-check-label"></label>
        <div class="form-text">
            Registra el pago junto con la membresía y genera el recibo. Si la desmarca, la membresía
            queda <b>pendiente de pago</b> y no dará acceso hasta que se cobre.
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-success">Guardar membresía</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
