@model List<GYMELITEGiTHub.Dtos.TipoMembresiaDto>
@{
    ViewData["Title"] = "Planes de membresía";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Planes de membresía</h1>
        <small class="text-muted">Administra modalidades, duración y precios.</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Volver a membresías</a>
        <a asp-action="CrearPlan" class="btn btn-success">+ Nuevo plan</a>
    </div>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}

@if (!Model.Any())
{
    <div class="alert alert-light border">No hay planes registrados.</div>
}
else
{
    <div class="table-responsive bg-white border rounded">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Plan</th>
                    <th>Modalidad</th>
                    <th>Duración</th>
                    <th>Precio</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var plan in Model)
            {
                <tr>
                    <td>@plan.Nombre</td>
                    <td>@plan.Modalidad</td>
                    <td>@plan.DuracionDias día(s)</td>
                    <td>@plan.PrecioTexto</td>
                    <td>
                        @if (plan.Activo)
                        {
                                <span class="badge" style="background:#E5F6ED; color:#16865A;">Activo</span>
                        }
                        else
                        {
                                <span class="badge" style="background:#FCEAE8; color:#B8433B;">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-2 align-items-center">
                            <a asp-action="EditarPlan" asp-route-id="@plan.Id">Editar</a>
                            <form asp-action="CambiarEstadoPlan" asp-route-id="@plan.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link p-0">
                                    @(plan.Activo ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
