@model GYMELITEGiTHub.ViewModels.TipoMembresiaFormViewModel

<partial name="_ErroresGenerales" />

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Modalidad" class="form-label"></label>
    <select asp-for="Modalidad" asp-items="new SelectList(GYMELITEGiTHub.ViewModels.TipoMembresiaFormViewModel.Modalidades)" class="form-select">
        <option value="">-- Seleccione --</option>
    </select>
    <span asp-validation-for="Modalidad" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="DuracionDias" class="form-label"></label>
    <input asp-for="DuracionDias" type="number" min="1" max="365" class="form-control" />
    <span asp-validation-for="DuracionDias" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Precio" class="form-label"></label>
    <input asp-for="Precio" type="number" step="0.01" min="0.01" class="form-control" />
    <span asp-validation-for="Precio" class="text-danger"></span>
</div>
