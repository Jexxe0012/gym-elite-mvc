@model GYMELITEGiTHub.ViewModels.MembresiaListaViewModel
@{
    ViewData["Title"] = "Membresías";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Membresías</h1>
        <small class="text-muted">Una membresía solo da acceso cuando tiene un pago válido.</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Planes" class="btn btn-outline-secondary">Planes</a>
        <a asp-action="Crear" class="btn btn-success">+ Registrar membresía</a>
    </div>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}
@if (TempData["Aviso"] is string aviso)
{
    <div class="alert alert-warning">@aviso</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-7">
        <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control"
               placeholder="Buscar por socio, código o plan..." />
    </div>
    <div class="col-md-3">
        <select name="estado" class="form-select">
            <option value="" selected="@string.IsNullOrEmpty(Model.Estado)">Todas</option>
            <option value="vigentes" selected="@(Model.Estado == "vigentes")">Vigentes</option>
            <option value="porvencer" selected="@(Model.Estado == "porvencer")">Por vencer (7 días)</option>
            <option value="pendientes" selected="@(Model.Estado == "pendientes")">Pendientes de pago</option>
            <option value="vencidas" selected="@(Model.Estado == "vencidas")">Vencidas</option>
            <option value="programadas" selected="@(Model.Estado == "programadas")">Programadas</option>
            <option value="canceladas" selected="@(Model.Estado == "canceladas")">Canceladas</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button class="btn btn-outline-secondary" type="submit">Filtrar</button>
    </div>
</form>

@if (!Model.Membresias.Any())
{
    <div class="alert alert-light border">No se encontraron membresías.</div>
}
else
{
    <div class="table-responsive bg-white border rounded">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Socio</th>
                    <th>Plan</th>
                    <th>Inicio</th>
                    <th>Vence</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var m in Model.Membresias)
            {
                <tr>
                    <td>@m.SocioCodigo · @m.SocioNombre</td>
                    <td>@m.TipoNombre</td>
                    <td>@m.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@m.FechaFin.ToString("dd/MM/yyyy")</td>
                    <td><partial name="_BadgeVigencia" model="m.Vigencia" /></td>
                    <td class="text-end">
                        <a asp-action="Detalle" asp-route-id="@m.Id">Ver</a>
                        @if (!m.EstaCancelada)
                        {
                            <text> · </text>
                            <a asp-action="Renovar" asp-route-socioId="@m.SocioId">Renovar</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
